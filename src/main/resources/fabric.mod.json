{
  "schemaVersion": 1,
  "id": "hivesight",
  "version": "${version}",
  "name": "Hive Sight",
  "description": "Bee hives made legible: shift-look a hive to see its bees and honey, shift-click to let a bee out.",
  "authors": ["trevorschoeny"],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "hivesight.mixins.json"
  ],
  "entrypoints": {
    "main": ["com.trevorschoeny.hivesight.HiveSight"],
    "client": ["com.trevorschoeny.hivesight.HiveSightClient"],
    "modmenu": ["com.trevorschoeny.hivesight.config.HSConfigModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "menukit": ">=2.0.0"
  }
}
